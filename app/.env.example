# Copy this file to app/.env and fill in the key. app/.env is git-ignored: never commit it.
# Used only by: node scripts/generate-voices.js (run in the app folder, on a PC with internet).

# Google Cloud Text-to-Speech API key (Cloud Console > APIs & Services > Credentials).
# Restrict it to the "Cloud Text-to-Speech API".
GOOGLE_TTS_API_KEY=

# Optional: the Chirp 3: HD voice used for English, Hindi and Telugu (Kore is a clear female voice).
# TTS_VOICE=Kore
# Or a full voice name per language:
# TTS_VOICE_EN_IN=en-IN-Chirp3-HD-Kore
# TTS_VOICE_HI_IN=hi-IN-Chirp3-HD-Kore
# TTS_VOICE_TE_IN=te-IN-Chirp3-HD-Kore

# Optional: speaking pace (1 = normal).
# TTS_SPEAKING_RATE=0.95

# Stop before this many characters a month (Chirp 3: HD: first 1,000,000 a month free).
# TTS_MONTHLY_LIMIT=950000
